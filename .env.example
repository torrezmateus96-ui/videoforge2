# ==============================================================================
# DarkForge Channel OS — Configuração de Ambiente (NUNCA COMMITAR SEGREDOS)
# Copie para .env.local (web) e .env (api/workers) e preencha no ambiente seguro.
# ==============================================================================

# --- AI Studio Runtime ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- Supabase (obrigatório em SP-01+) ---
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:SENHA@db.seu-projeto.supabase.co:5432/postgres?sslmode=require

# --- API Local & Segurança ---
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
TOKEN_ENCRYPTION_KEY=

# --- HTTP Pool Tuning (RH-02) ---
SUPABASE_HTTP_MAX_CONNECTIONS=40
SUPABASE_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
SUPABASE_HTTP_KEEPALIVE_EXPIRY_SECONDS=30.0
SUPABASE_HTTP_POOL_TIMEOUT_SECONDS=5.0

# --- YouTube OAuth (obrigatório em SP-03+) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/connections/youtube/callback

# --- AI Provider Router (SP-05/SP-06/SP-07) ---
AI_DEFAULT_MODE=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=

# --- Desenvolvimento Local (RH-01: opcional, nunca usar segredo real) ---
NEXT_PUBLIC_DEV_AUTOFILL_EMAIL=

# --- Diretório descartável local & Núcleo DarkForge (SP-08) ---
DARKFORGE_LOCAL_TEMP_DIR=%LOCALAPPDATA%\DarkForge
DARKFORGE_CORE_PATH=
